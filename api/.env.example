PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/receitas
# Em produção Railway, SSL costuma ser necessário (padrão). Local: DATABASE_SSL=false
DATABASE_SSL=false
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
# Caminho do site estático (padrão: pasta pai de api/)
# SITE_ROOT=..
COOKIE_SECURE=false
NODE_ENV=development
